{% macro icon(name, size=20) -%}
<svg class="icon icon-{{ name }}" width="{{ size }}" height="{{ size }}" aria-hidden="true"><use href="#i-{{ name }}"></use></svg>
{%- endmacro %}

{% macro nav_button(page, label, icon_name, index) -%}
<button class="nav-item{% if page == 'providers' %} is-active{% endif %}" type="button" data-page="{{ page }}">
  {{ icon(icon_name, 19) }}<span>{{ label }}</span><span class="nav-index">{{ index }}</span>
</button>
{%- endmacro %}

{% macro theme_option(theme) -%}
<button class="theme-option" type="button" role="option" data-theme-value="{{ theme.id }}">
  <span class="theme-swatch" style="--swatch: {{ theme.swatch }}"></span>
  <span>{{ theme.name }}</span>{{ icon('check', 16) }}
</button>
{%- endmacro %}
