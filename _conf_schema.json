            "hint": "0 表示不限制"
          },
          "params": {
            "type": "object",
            "description": "提交参数（可自由增删键值）",
            "hint": "_endpoint 为请求路径（默认 images/generations）；其余参数原样写入请求体",
            "items": {
              "_endpoint": {
                "type": "string",
                "default": "images/generations",
                "description": "API 端点路径"
              },
              "size": {
                "type": "string",
                "default": "1024x1024",
                "description": "图片尺寸"
