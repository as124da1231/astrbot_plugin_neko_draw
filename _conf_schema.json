          },
          "refer_field": {
            "type": "str",
            "default": "images",
            "description": "参考图字段名",
            "hint": "图生图模型填 images（或该模型实际字段名）；文生图留空"
          },
          "max_refer_images": {
            "type": "int",
            "default": 10,
            "description": "参考图数量上限"
          },
          "min_prompt_length": {
            "type": "int",
            "default": 0,
            "description": "提示词最小长度",
            "hint": "0 表示不限制。RunningHub 模型要求至少 5 个字符"
          },
          "params": {
            "type": "object",
            "description": "提交参数（可自由增删键值）",
            "items": {
              "resolution": {
                "type": "string",
