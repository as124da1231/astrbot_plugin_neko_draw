{
  "model_providers": {
    "type": "template_list",
    "description": "模型提供商",
    "hint": "可添加多个提供商。名称必须唯一；类型决定接口协议，也可以引用 AstrBot 中已经配置的 OpenAI 兼容模型提供商。",
    "default": [
      {
        "__template_key": "provider_item",
        "type": "WaveSpeed",
        "name": "WaveSpeed",
        "api_key": "",
        "base_url": "https://api.wavespeed.ai/api/v3"
      },
      {
        "__template_key": "provider_item",
        "type": "RunningHub",
        "name": "RunningHub",
        "api_key": "",
        "base_url": "https://www.runninghub.cn/openapi/v2"
      },
      {
        "__template_key": "provider_item",
        "type": "OpenAI",
        "name": "OpenAI",
        "api_key": "",
        "base_url": "https://api.openai.com/v1"
      }
    ],
    "templates": {
      "provider_item": {
        "name": "模型提供商",
        "items": {
          "type": {
            "type": "string",
            "default": "OpenAI",
            "description": "提供商类型",
            "hint": "决定使用的 API 协议",
            "options": [
              "WaveSpeed",
              "RunningHub",
              "OpenAI",
              "AstrBot"
            ],
            "option_labels": {
              "WaveSpeed": "WaveSpeed",
              "RunningHub": "RunningHub",
              "OpenAI": "OpenAI 兼容",
              "AstrBot": "AstrBot 已有提供商"
            }
          },
          "name": {
            "type": "string",
            "default": "",
            "description": "提供商名称",
            "hint": "供模型模板选择，必须唯一，例如 OpenAI 主账号"
          },
          "api_key": {
            "type": "string",
            "default": "",
            "description": "API Key",
            "hint": "使用该提供商调用模型时所需的密钥",
            "secret": true
          },
          "base_url": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "description": "API Base URL",
            "hint": "填写与提供商类型对应的接口根地址"
          },
          "astrbot_provider_id": {
            "type": "string",
            "default": "",
            "description": "AstrBot 模型提供商",
            "hint": "直接引用 AstrBot 模型提供商页面中已保存的提供商，不复制 API Key"
          },
          "astrbot_protocol": {
            "type": "string",
            "default": "auto",
            "description": "图像接口协议",
            "hint": "自动会根据 AstrBot 提供商的 API 地址识别；识别不正确时可以手动指定",
            "options": ["auto", "WaveSpeed", "RunningHub", "OpenAI"],
            "option_labels": {
              "auto": "自动识别",
              "WaveSpeed": "WaveSpeed",
              "RunningHub": "RunningHub",
              "OpenAI": "OpenAI 兼容"
            }
          }
        }
      }
    }
  },
  "default_text_model": {
    "type": "string",
    "description": "默认文生图模板名",
    "hint": "从已保存并允许作为默认模型的文生图模板中选择；无图消息使用",
    "default": "seedream_v5_pro"
  },
  "default_edit_model": {
    "type": "string",
    "description": "默认编辑（图生图）模板名",
    "hint": "从已保存并允许作为默认模型的图片编辑模板中选择；带图消息使用，--model edit 也指向它",
    "default": "seedream_v5_pro_edit"
  },
  "model_templates": {
    "type": "template_list",
    "description": "模型模板",
    "hint": "每个模型模板选择一个已配置的模型提供商，并设置模型名、提交参数和参考图字段。",
    "default": [
      {
        "__template_key": "model_template",
        "name": "seedream_v5_pro",
        "provider": "WaveSpeed",
        "model": "bytedance/seedream-v5.0-pro",
        "enabled": true,
        "enabled_as_default": true,
        "fallback_order": 0,
        "refer_field": "",
        "max_refer_images": 10,
        "min_prompt_length": 0,
        "params": {
          "aspect_ratio": "1:1",
          "resolution": "1k",
          "output_format": "jpeg",
          "prompt_optimization_mode": "fast"
        }
      },
      {
        "__template_key": "model_template",
        "name": "seedream_v5_pro_edit",
        "provider": "WaveSpeed",
        "model": "bytedance/seedream-v5.0-pro/edit",
        "enabled": true,
        "enabled_as_default": true,
        "fallback_order": 1,
        "refer_field": "images",
        "max_refer_images": 10,
        "min_prompt_length": 0,
        "params": {
          "resolution": "1k",
          "output_format": "jpeg",
          "prompt_optimization_mode": "fast"
        }
      },
      {
        "__template_key": "model_template",
        "name": "rh_seedream_lite",
        "provider": "RunningHub",
        "model": "seedream-v5-lite/text-to-image",
        "enabled": true,
        "enabled_as_default": false,
        "fallback_order": 10,
        "refer_field": "",
        "max_refer_images": 0,
        "min_prompt_length": 5,
        "params": {
          "width": 2048,
          "height": 2048,
          "maxImages": 1,
          "sequentialImageGeneration": "disabled"
        }
      },
      {
        "__template_key": "model_template",
        "name": "rh_dola_seedream_edit",
        "provider": "RunningHub",
        "model": "dola-Seedream-5.0-pro/image-to-image",
        "enabled": true,
        "enabled_as_default": false,
        "fallback_order": 11,
        "refer_field": "imageUrls",
        "max_refer_images": 10,
        "min_prompt_length": 5,
        "params": {
          "resolution": "2k",
          "outputFormat": "jpeg"
        }
      },
      {
        "__template_key": "model_template",
        "name": "openapi_generic",
        "provider": "OpenAI",
        "model": "gpt-image-2",
        "enabled": true,
        "enabled_as_default": false,
        "fallback_order": 20,
        "refer_field": "",
        "max_refer_images": 0,
        "min_prompt_length": 0,
        "params": {
          "_endpoint": "images/generations",
          "size": "1024x1024",
          "n": 1
        }
      }
    ],
    "templates": {
      "model_template": {
        "name": "模型模板",
        "items": {
          "name": {
            "type": "str",
            "default": "",
            "description": "模板名称",
            "hint": "供 --model 参数引用，必须唯一"
          },
          "provider": {
            "type": "string",
            "default": "OpenAI",
            "description": "选择模型提供商",
            "hint": "填写模型提供商列表中已存在的唯一名称"
          },
          "model": {
            "type": "str",
            "default": "",
            "description": "模型名",
            "hint": "填写所选提供商支持的模型名或模型接口路径"
          },
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "启用模板"
          },
          "enabled_as_default": {
            "type": "bool",
            "default": false,
            "description": "允许作为默认模型"
          },
          "fallback_order": {
            "type": "int",
            "default": 20,
            "description": "默认回退优先级",
            "hint": "默认模板未设置、被停用或不存在时使用；数字越小优先级越高，0 高于 10，10 高于 20"
          },
          "refer_field": {
            "type": "str",
            "default": "",
            "description": "参考图字段名",
            "hint": "文生图留空；图片编辑填写提供商要求的参考图字段名"
          },
          "max_refer_images": {
            "type": "int",
            "default": 0,
            "description": "参考图数量上限"
          },
          "min_prompt_length": {
            "type": "int",
            "default": 0,
            "description": "提示词最小长度",
            "hint": "0 表示不限制"
          },
          "params": {
            "type": "object",
            "description": "提交参数（可自由增删键值）",
            "hint": "发送给模型接口的参数；_endpoint 可指定 OpenAI 兼容请求路径",
            "items": {
              "_endpoint": {
                "type": "string",
                "default": "images/generations",
                "description": "API 端点路径"
              },
              "size": {
                "type": "string",
                "default": "1024x1024",
                "description": "图片尺寸"
              },
              "n": {
                "type": "int",
                "default": 1,
                "description": "生成数量"
              }
            },
            "default": {}
          }
        }
      }
    }
  },
  "image_providers": {
    "type": "template_list",
    "description": "模型提供商与模型",
    "hint": "像 AstrBot 一样在一个提供商下管理连接和模型。旧版提供商与模型模板会自动迁移到这里。",
    "default": [],
    "templates": {
      "image_provider": {
        "name": "模型提供商",
        "items": {
          "name": {"type": "string", "default": "", "description": "提供商名称", "hint": "必须唯一，例如 硅基流动"},
          "protocol": {"type": "string", "default": "OpenAI", "description": "图像接口协议", "options": ["OpenAI", "WaveSpeed", "RunningHub"], "option_labels": {"OpenAI": "OpenAI 兼容", "WaveSpeed": "WaveSpeed", "RunningHub": "RunningHub"}},
          "api_key": {"type": "string", "default": "", "description": "API Key", "secret": true},
          "base_url": {"type": "string", "default": "https://api.openai.com/v1", "description": "API Base URL", "hint": "填写根地址，例如 https://api.siliconflow.cn/v1；模型请求路径在模型设置中管理"},
          "enabled": {"type": "bool", "default": true, "description": "启用提供商"},
          "timeout": {"type": "int", "default": 300, "description": "超时时间", "hint": "仅对该提供商生效，单位为秒"},
          "proxy": {"type": "string", "default": "", "description": "代理地址", "hint": "仅对该提供商的 API 请求生效"},
          "custom_headers": {"type": "object", "default": {}, "description": "自定义请求头"},
          "models": {"type": "list", "default": [], "description": "模型列表"}
        }
      }
    }
  },
  "default_text_model_v2": {
    "type": "string",
    "description": "默认文生图模型",
    "hint": "从插件内已启用模型或 AstrBot 已有模型中选择",
    "default": ""
  },
  "default_edit_model_v2": {
    "type": "string",
    "description": "默认图片编辑模型",
    "hint": "从插件内已启用模型或 AstrBot 已有模型中选择",
    "default": ""
  },
  "prompt": {
    "type": "template_list",
    "description": "预设提示词",
    "hint": "每项左边填触发词，右边填提示词模板。{{user_text}} 会被消息文本替换。默认 nd=文生图，nde=编辑模式（--model edit 指向默认编辑模板）",
    "default": [
      {
        "__template_key": "prompt_item",
        "trigger": "nd",
        "prompt": "{{user_text}}"
      },
      {
        "__template_key": "prompt_item",
        "trigger": "nde",
        "prompt": "{{user_text}} --model edit"
      }
    ],
    "templates": {
      "prompt_item": {
        "name": "预设提示词",
        "items": {
          "trigger": {
            "type": "str",
            "default": "",
            "description": "触发词",
            "hint": "消息以该词开头时触发此预设（默认 nd、nde）"
          },
          "prompt": {
            "type": "str",
            "default": "{{user_text}}",
            "description": "提示词模板",
            "hint": "{{user_text}} 会被用户消息文本替换；可附带 --参数 值，如 {{user_text}} --model edit"
          },
          "reference_image": {
            "type": "file",
            "default": [],
            "file_types": [
              "jpg",
              "jpeg",
              "png",
              "webp",
              "gif",
              "bmp"
            ],
            "description": "风格参考图",
            "hint": "点击上传此预设的风格参考图。触发此预设时会自动作为参考图传给绘图 API。可上传多张，取最后上传的一张。通过 /nc pa 添加的预设可在 WebUI 中继续设置此字段"
          },
          "reference_image_position": {
            "type": "string",
            "default": "before",
            "options": [
              "before",
              "after"
            ],
            "description": "参考图位置",
            "hint": "此预设的参考图与用户上传图片的排列顺序。before=预设参考图在前（风格优先），after=用户上传图在前（用户图优先）"
          }
        }
      }
    }
  },
  "enable_drawing_message": {
    "type": "bool",
    "description": "开始生成时发送提示",
    "default": true
  },
  "drawing_message": {
    "type": "string",
    "description": "开始画图提示文案",
    "hint": "留空则不发送",
    "default": "小猫正在搓屏幕中"
  },
  "enable_apng_wrap": {
    "type": "bool",
    "description": "生图使用首帧包装",
    "hint": "开启后，模型生成的图片会临时包装成两帧 APNG；发送后自动清理临时动画，历史记录只保留并查看原始生成图。此开关不影响 apng 指令制作动画",
    "default": false
  },
  "drawing_first_frame_path": {
    "type": "file",
    "description": "生图默认首帧",
    "hint": "仅供模型生成图片的首帧包装使用；未上传时使用插件内置默认图，与 APNG 制作首帧互不影响",
    "default": [],
    "file_types": ["jpg", "jpeg", "png", "webp", "gif", "bmp"]
  },
  "drawing_first_frame_duration": {
    "type": "int",
    "description": "生图首帧时长（毫秒）",
    "hint": "生图包装的第一帧停留时间，默认 100 毫秒",
    "default": 100
  },
  "drawing_second_frame_duration": {
    "type": "int",
    "description": "生图结果帧时长（毫秒）",
    "hint": "模型生成图片所在第二帧的停留时间，默认 20000 毫秒",
    "default": 20000
  },
  "drawing_apng_loop": {
    "type": "int",
    "description": "生图包装循环次数",
    "hint": "0 = 无限循环；1 = 播放一次；N = 播放 N 次",
    "default": 0
  },
  "drawing_apng_optimize": {
    "type": "bool",
    "description": "生图包装压缩优化",
    "hint": "开启后压缩模型生成图片的 APNG 包装文件",
    "default": true
  },
  "apng_first_frame_path": {
    "type": "file",
    "description": "APNG 默认首帧",
    "hint": "仅供 apng 指令在最低图片数为 1 时补入；未上传时使用插件内置默认图，与生图首帧互不影响",
    "default": [],
    "file_types": [
      "jpg",
      "jpeg",
      "png",
      "webp",
      "gif",
      "bmp"
    ]
  },
  "apng_first_frame_duration": {
    "type": "int",
    "description": "APNG 默认首帧时长（毫秒）",
    "hint": "未在 apng 指令中使用 --fd 指定首帧秒数时采用此值；单图和多图制作都生效",
    "default": 100
  },
  "apng_default_interval_seconds": {
    "type": "float",
    "description": "APNG 默认间隔秒数",
    "hint": "只输入 apng、没有填写间隔参数时使用；默认每张图片停留 5 秒",
    "default": 5
  },
  "apng_loop": {
    "type": "int",
    "description": "APNG 循环次数",
    "hint": "0 = 无限循环；1 = 播放一次；N = 播放 N 次。QQ 手机端查看 APNG 时通常会始终无限循环，客户端可能忽略这里写入的循环次数",
    "default": 0
  },
  "apng_optimize": {
    "type": "bool",
    "description": "APNG 压缩优化",
    "hint": "开启后对 APNG 进行压缩优化，减小文件体积",
    "default": true
  },
  "apng_maker_max_frames": {
    "type": "int",
    "description": "APNG 制作最大帧数",
    "hint": "apng 指令单次允许合成的最大图片数量；默认 20 张",
    "default": 20
  },
  "apng_maker_min_frames": {
    "type": "int",
    "description": "APNG 制作最低图片数",
    "hint": "默认 2。设为 1 时，只发送一张图片也能制作；插件会在前面自动加入当前默认首帧",
    "default": 2
  },
  "apng_maker_max_dimension": {
    "type": "int",
    "description": "APNG 制作最大边长",
    "hint": "为控制文件体积，合成画布的宽和高不会超过此值；默认 2048 像素",
    "default": 2048
  },
  "apng_cleanup_after_send": {
    "type": "bool",
    "description": "APNG 发送后立即清理",
    "hint": "默认关闭。开启后，发送成功便删除服务器上的 APNG 文件，不写入独立 APNG 记录；关闭时可在 APNG 作品页面查看、下载和删除",
    "default": false
  },
  "apng_enable_drawing_message": {
    "type": "bool",
    "description": "APNG 制作时发送提示",
    "hint": "图片检查通过并开始下载、合成 APNG 时发送提示消息",
    "default": true
  },
  "apng_drawing_message": {
    "type": "string",
    "description": "APNG 制作提示文案",
    "hint": "留空则不发送",
    "default": "🐱 猫娘正在制作 APNG，请稍候..."
  },
  "apng_enable_image_summary": {
    "type": "bool",
    "description": "APNG 外显金句",
    "hint": "仅控制 apng 指令成品的 QQ 图片外显金句，不影响模型生图",
    "default": false
  },
  "apng_image_summary_quotes": {
    "type": "list",
    "description": "APNG 外显金句列表",
    "hint": "随机抽取一句用于 APNG 成品的图片外显",
    "default": ["你已被移出群聊", "[群主女装图]", "哎呦，你干嘛~", "Ciallo～(∠・ω< )⌒☆"]
  },
  "apng_image_summary_quotes_files": {
    "type": "list",
    "description": "APNG 金句文件路径",
    "hint": "JSON 数组格式；多个文件内容会与 APNG 金句列表合并",
    "default": []
  },
  "apng_enable_forward_message": {
    "type": "bool",
    "description": "APNG 使用合并转发发送",
    "hint": "仅控制 apng 指令成品，开启后使用 QQ 合并转发聊天记录卡片发送",
    "default": false
  },
  "apng_forward_node_name": {
    "type": "string",
    "description": "APNG 转发节点昵称",
    "hint": "APNG 合并转发卡片中显示的发送者昵称",
    "default": "猫娘画图 APNG"
  },
  "apng_enable_at_sender": {
    "type": "bool",
    "description": "发送 APNG 时 @ 触发者",
    "hint": "仅控制 apng 指令成品；私聊自动忽略",
    "default": false
  },
  "enable_image_summary": {
    "type": "bool",
    "description": "生图外显金句",
    "hint": "仅控制模型生成图片，不影响 apng 指令成品（仅 aiocqhttp 平台可用，多图时自动回退普通图片）",
    "default": false
  },
  "image_summary_quotes": {
    "type": "list",
    "description": "生图外显金句列表",
    "hint": "随机抽取一句用于模型生成图片的外显",
    "default": [
      "你已被移出群聊",
      "[群主女装图]",
      "哎呦，你干嘛~",
      "Ciallo～(∠・ω< )⌒☆"
    ]
  },
  "image_summary_quotes_files": {
    "type": "list",
    "description": "生图金句文件路径",
    "hint": "可在 JSON 文件中维护生图金句（数组格式），多个路径会与列表合并",
    "default": []
  },
  "enable_forward_message": {
    "type": "bool",
    "description": "生图使用合并转发发送",
    "hint": "仅控制模型生成图片，开启后使用 QQ 合并转发聊天记录卡片发送",
    "default": false
  },
  "forward_node_name": {
    "type": "string",
    "description": "生图转发节点昵称",
    "hint": "生图合并转发卡片中显示的发送者昵称",
    "default": "猫娘画图"
  },
  "enable_at_sender": {
    "type": "bool",
    "description": "发送生图时 @ 触发者",
    "hint": "仅控制模型生成图片；私聊自动忽略",
    "default": false
  },
  "enable_rate_limit": {
    "type": "bool",
    "description": "启用单用户限流",
    "hint": "开启后对单用户的绘图触发频率进行限制。可配置多个规则同时生效，任一规则超限即触发限流。限流白名单用户不受限制",
    "default": false
  },
  "rate_limit_rules": {
    "type": "template_list",
    "description": "限流规则",
    "hint": "可添加多个限流规则，同时生效。每个规则独立检查，任一规则超限即触发限流。默认两个规则：300秒内3次（短期防刷屏）+ 每日10次（长期限额）",
    "default": [
      {
        "__template_key": "rate_limit_rule",
        "window_seconds": 300,
        "max_count": 3
      },
      {
        "__template_key": "rate_limit_rule",
        "window_seconds": 86400,
        "max_count": 10
      }
    ],
    "templates": {
      "rate_limit_rule": {
        "name": "限流规则",
        "items": {
          "window_seconds": {
            "type": "int",
            "default": 300,
            "description": "时间窗口（秒）",
            "hint": "在此时间窗口内最多使用 max_count 次。常用值：60=1分钟、300=5分钟、3600=1小时、86400=1天"
          },
          "max_count": {
            "type": "int",
            "default": 3,
            "description": "最大次数",
            "hint": "时间窗口内最多触发绘图的次数（按触发消息计数，不按生成图片张数）"
          }
        }
      }
    }
  },
  "rate_limit_whitelist": {
    "type": "list",
    "description": "限流白名单",
    "hint": "在此列表中的用户不受限流限制。填写用户QQ号或用户ID",
    "default": []
  },
  "rate_limit_message": {
    "type": "string",
    "description": "限流提示文案",
    "hint": "超过限流时 @ 用户发送的提示文案。支持占位符：{window}=时间窗口描述、{max_count}=最大次数、{retry_after}=还需等待秒数",
    "default": "🐱 绘图频率过高，{window}内最多{max_count}次，请{retry_after}秒后再试"
  },
  "whitelist_enabled": {
    "type": "bool",
    "description": "启用白名单",
    "default": false,
    "hint": "开启后仅白名单用户/群组可使用绘图"
  },
  "group_whitelist": {
    "type": "list",
    "description": "群组白名单",
    "hint": "群号列表",
    "default": []
  },
  "user_whitelist": {
    "type": "list",
    "description": "用户白名单",
    "hint": "用户ID列表",
    "default": []
  },
  "proxy": {
    "type": "string",
    "description": "代理地址",
    "hint": "如 http://127.0.0.1:7890，留空不使用代理",
    "default": ""
  },
  "poll_interval": {
    "type": "int",
    "description": "轮询间隔（秒）",
    "default": 2
  },
  "max_concurrency": {
    "type": "int",
    "description": "最大并发任务数",
    "hint": "WaveSpeed 免费/标准套餐一般允许同时运行 2 个预测任务。超出时插件自动排队等待，而不是直接报错。升级套餐后可调大",
    "default": 2
  },
  "max_429_retries": {
    "type": "int",
    "description": "429 并发限制最大重试次数",
    "hint": "即使有并发排队，若其他客户端也在占用额度，提交仍可能返回 429。此参数控制提交遇到 429 时的重试次数（指数退避）",
    "default": 5
  },
  "retry_429_delay": {
    "type": "int",
    "description": "429 重试初始等待（秒）",
    "hint": "每次重试等待时间按 2 的幂递增：2s、4s、8s...",
    "default": 2
  },
  "timeout": {
    "type": "int",
    "description": "任务超时（秒）",
    "default": 300
  }
}
