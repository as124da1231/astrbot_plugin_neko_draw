  },
  "prompt": {
    "type": "template_list",
    "description": "预设提示词",
    "hint": "每项左边填触发词，右边填提示词模板。{{user_text}} 会被消息文本替换。猫娘画图=文生图，猫娘改图=编辑模式（--model edit 指向默认编辑模板）",
    "default": [
      {
        "__template_key": "prompt_item",
        "trigger": "猫娘画图",
        "prompt": "{{user_text}}"
      },
      {
        "__template_key": "prompt_item",
        "trigger": "猫娘改图",
        "prompt": "{{user_text}} --model edit"
      }
    ],
    "templates": {
      "prompt_item": {
        "name": "预设提示词",
        "items": {
          "trigger": {
            "type": "str",
            "default": "",
            "description": "触发词",
            "hint": "消息以该词开头时触发此预设（如 猫娘画图、猫娘改图）"
          },
          "prompt": {
            "type": "str",
            "default": "{{user_text}}",
            "description": "提示词模板",
            "hint": "{{user_text}} 会被用户消息文本替换；可附带 --参数 值，如 {{user_text}} --model edit"
          },
          "reference_image": {
            "type": "file",
            "default": [],
            "file_types": ["jpg", "jpeg", "png", "webp", "gif", "bmp"],
            "description": "风格参考图",
            "hint": "点击上传此预设的风格参考图。触发此预设时会自动作为参考图传给绘图 API。可上传多张，取最后上传的一张。命令行 /猫娘添加 的预设无此字段，需在 WebUI 配置"
          },
          "reference_image_position": {
            "type": "string",
            "default": "before",
            "options": ["before", "after"],
            "description": "参考图位置",
            "hint": "此预设的参考图与用户上传图片的排列顺序。before=预设参考图在前（风格优先），after=用户上传图在前（用户图优先）"
          }
        }
      }
    }
  },
  "enable_drawing_message": {
    "type": "bool",
    "description": "开始生成时发送提示",
    "default": true
  },
  "drawing_message": {
    "type": "string",
    "description": "开始画图提示文案",
    "hint": "留空则不发送",
    "default": "🐱 猫娘正在画图，请稍候..."
  },
  "enable_apng_wrap": {
    "type": "bool",
    "description": "APNG 动图包装",
    "hint": "开启后生成的图片会被包装成两帧 APNG 动图：第一帧快速闪过（可配置），第二帧为生成的图片。处理链：生成图→APNG→外显金句→合并转发",
    "default": false
  },
  "apng_first_frame_path": {
    "type": "file",
    "description": "APNG 第一帧图片",
    "hint": "点击上传第一帧（快速闪过的帧）图片。支持 jpg/jpeg/png/webp/gif/bmp。可上传多张，取最后上传的一张使用。未上传时使用插件内置默认图。上传后文件保存在插件数据目录",
    "default": [],
    "file_types": ["jpg", "jpeg", "png", "webp", "gif", "bmp"]
  },
  "apng_first_frame_duration": {
    "type": "int",
    "description": "APNG 第一帧显示时长（毫秒）",
    "hint": "第一帧停留时间，越小闪得越快。示例 100ms 几乎是一闪而过",
    "default": 100
  },
  "apng_second_frame_duration": {
    "type": "int",
    "description": "APNG 第二帧显示时长（毫秒）",
    "hint": "第二帧（生成的图片）停留时间。示例 20000ms = 20秒",
    "default": 20000
  },
  "apng_loop": {
    "type": "int",
    "description": "APNG 循环次数",
    "hint": "0 = 无限循环；1 = 只播放一次；N = 播放 N 次",
    "default": 0
  },
  "apng_optimize": {
    "type": "bool",
    "description": "APNG 压缩优化",
    "hint": "开启后对 APNG 进行压缩优化，减小文件体积",
    "default": true
  },
  "enable_image_summary": {
    "type": "bool",
    "description": "图片外显金句",
    "hint": "开启后单张图片在 QQ 群列表中不再显示「[图片]」，而是随机显示一句金句（仅 aiocqhttp 平台可用，多图时自动回退普通图片）",
    "default": false
  },
  "image_summary_quotes": {
    "type": "list",
    "description": "外显金句列表",
    "hint": "随机抽取一句用于图片外显。可按需自行补充",
    "default": [
      "你已被移出群聊",
      "[群主女装图]",
      "哎呦，你干嘛~",
      "Ciallo～(∠・ω< )⌒☆"
    ]
  },
  "image_summary_quotes_files": {
    "type": "list",
    "description": "金句文件路径",
    "hint": "可在 JSON 文件中维护金句（数组格式）。支持相对路径与绝对路径，多个路径会与默认金句合并后随机抽取",
    "default": []
  },
  "enable_forward_message": {
    "type": "bool",
    "description": "合并转发（聊天记录）形式发送图片",
    "hint": "开启后生成的图片会打包成 QQ 合并转发消息卡片发出。与图片外显独立，都开启时合并转发优先（仅 aiocqhttp 平台支持）",
    "default": false
  },
  "forward_node_name": {
    "type": "string",
    "description": "合并转发节点昵称",
    "hint": "合并转发卡片中显示的发送者昵称",
    "default": "猫娘画图"
  },
  "enable_at_sender": {
    "type": "bool",
    "description": "发送图片时 @ 触发者",
    "hint": "开启后群聊中发送图片时会在消息前 @ 触发绘图的用户，方便多人同时出图时区分归属。私聊自动忽略",
    "default": false
  },
  "enable_rate_limit": {
    "type": "bool",
    "description": "启用单用户限流",
    "hint": "开启后对单用户的绘图触发频率进行限制。可配置多个规则同时生效，任一规则超限即触发限流。限流白名单用户不受限制",
    "default": false
  },
  "rate_limit_rules": {
    "type": "template_list",
    "description": "限流规则",
    "hint": "可添加多个限流规则，同时生效。每个规则独立检查，任一规则超限即触发限流。默认两个规则：300秒内3次（短期防刷屏）+ 每日10次（长期限额）",
    "default": [
      {
        "__template_key": "rate_limit_rule",
        "window_seconds": 300,
        "max_count": 3
      },
      {
        "__template_key": "rate_limit_rule",
        "window_seconds": 86400,
        "max_count": 10
      }
    ],
    "templates": {
      "rate_limit_rule": {
        "name": "限流规则",
        "items": {
          "window_seconds": {
            "type": "int",
            "default": 300,
            "description": "时间窗口（秒）",
            "hint": "在此时间窗口内最多使用 max_count 次。常用值：60=1分钟、300=5分钟、3600=1小时、86400=1天"
          },
          "max_count": {
            "type": "int",
            "default": 3,
            "description": "最大次数",
            "hint": "时间窗口内最多触发绘图的次数（按触发消息计数，不按生成图片张数）"
          }
        }
      }
    }
  },
  "rate_limit_whitelist": {
    "type": "list",
    "description": "限流白名单",
    "hint": "在此列表中的用户不受限流限制。填写用户QQ号或用户ID",
    "default": []
  },
  "rate_limit_message": {
    "type": "string",
    "description": "限流提示文案",
    "hint": "超过限流时 @ 用户发送的提示文案。支持占位符：{window}=时间窗口描述、{max_count}=最大次数、{retry_after}=还需等待秒数",
    "default": "🐱 绘图频率过高，{window}内最多{max_count}次，请{retry_after}秒后再试"
  },
  "whitelist_enabled": {
    "type": "bool",
    "description": "启用白名单",
    "default": false,
    "hint": "开启后仅白名单用户/群组可使用绘图"
  },
  "group_whitelist": {
    "type": "list",
    "description": "群组白名单",
    "hint": "群号列表",
    "default": []
  },
  "user_whitelist": {
    "type": "list",
    "description": "用户白名单",
    "hint": "用户ID列表",
    "default": []
  },
  "proxy": {
    "type": "string",
    "description": "代理地址",
    "hint": "如 http://127.0.0.1:7890，留空不使用代理",
    "default": ""
  },
  "poll_interval": {
    "type": "int",
    "description": "轮询间隔（秒）",
    "default": 2
  },
  "max_concurrency": {
    "type": "int",
    "description": "最大并发任务数",
    "hint": "WaveSpeed 免费/标准套餐一般允许同时运行 2 个预测任务。超出时插件自动排队等待，而不是直接报错。升级套餐后可调大",
    "default": 2
  },
  "max_429_retries": {
    "type": "int",
    "description": "429 并发限制最大重试次数",
    "hint": "即使有并发排队，若其他客户端也在占用额度，提交仍可能返回 429。此参数控制提交遇到 429 时的重试次数（指数退避）",
    "default": 5
  },
  "retry_429_delay": {
    "type": "int",
    "description": "429 重试初始等待（秒）",
    "hint": "每次重试等待时间按 2 的幂递增：2s、4s、8s...",
    "default": 2
  },
  "timeout": {
    "type": "int",
    "description": "任务超时（秒）",
    "default": 300
  }
}
