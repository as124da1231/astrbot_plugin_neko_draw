        }
      },
      "openapi_text": {
        "name": "OpenAI",
        "items": {
          "name": {
            "type": "str",
            "default": "openapi_generic",
            "description": "模板名称",
            "hint": "--model 参数引用，必须唯一"
          },
          "provider": {
            "type": "str",
            "default": "openapi",
            "description": "API 提供商",
            "hint": "wavespeed / runninghub / openapi"
          },
          "model": {
            "type": "str",
            "default": "gpt-image-2",
            "description": "模型名",
            "hint": "放入请求体的 model 字段（不拼 URL）"
          },
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "启用模板"
          },
          "enabled_as_default": {
            "type": "bool",
            "default": false,
            "description": "允许作为默认模型"
          },
