{
  "api_key": {
    "type": "string",
    "description": "WaveSpeed API Key",
    "hint": "在 https://wavespeed.ai 后台获取，格式如 wsk_live_xxx",
    "default": "",
    "secret": true
  },
  "base_url": {
    "type": "string",
    "description": "WaveSpeed API Base URL",
    "default": "https://api.wavespeed.ai/api/v3"
  },
  "runninghub_api_key": {
    "type": "string",
    "description": "RunningHub API Key",
    "hint": "在 https://www.runninghub.cn 后台获取，32位密钥。使用 RunningHub 模型时必填",
    "default": "",
    "secret": true
  },
  "runninghub_base_url": {
    "type": "string",
    "description": "RunningHub API Base URL",
    "default": "https://www.runninghub.cn/openapi/v2"
  },
  "openapi_api_key": {
    "type": "string",
    "description": "OpenAI 兼容 API Key",
    "hint": "适用于所有 OpenAI 兼容格式的图像 API（OpenAI / SiliconFlow / 各类中转）。使用 openapi 提供商时必填",
    "default": "",
    "secret": true
  },
  "openapi_base_url": {
    "type": "string",
    "description": "OpenAI 兼容 API Base URL",
    "hint": "如 https://api.openai.com/v1、https://api.siliconflow.cn/v1 等",
    "default": "https://api.openai.com/v1"
  },
  "default_text_model": {
    "type": "string",
    "description": "默认文生图模板名",
    "hint": "填写 model_templates 中某个模板的 name。无图消息使用",
    "default": "seedream_v5_pro"
  },
  "default_edit_model": {
    "type": "string",
    "description": "默认编辑（图生图）模板名",
    "hint": "填写 model_templates 中某个模板的 name。带图消息使用；--model edit 也指向它",
    "default": "seedream_v5_pro_edit"
  },
  "model_templates": {
    "type": "template_list",
    "description": "模型模板",
    "hint": "模板类型决定使用 WaveSpeed、RunningHub 或 OpenAI 对应的 API URL 与 Key。可自行设置唯一模板名、模型名、提交参数和参考图字段；提示词中的 --参数会覆盖模板同名参数，也可透传新参数",
    "default": [
      {
        "__template_key": "seedream_text",
        "name": "seedream_v5_pro",
        "provider": "wavespeed",
        "model": "bytedance/seedream-v5.0-pro",
        "enabled": true,
        "enabled_as_default": true,
        "fallback_order": 0,
        "refer_field": "",
        "max_refer_images": 10,
        "min_prompt_length": 0,
        "params": {
          "aspect_ratio": "1:1",
          "resolution": "1k",
          "output_format": "jpeg",
          "prompt_optimization_mode": "fast"
        }
      },
      {
        "__template_key": "seedream_edit",
        "name": "seedream_v5_pro_edit",
        "provider": "wavespeed",
        "model": "bytedance/seedream-v5.0-pro/edit",
        "enabled": true,
        "enabled_as_default": true,
        "fallback_order": 1,
        "refer_field": "images",
        "max_refer_images": 10,
        "min_prompt_length": 0,
        "params": {
          "resolution": "1k",
          "output_format": "jpeg",
          "prompt_optimization_mode": "fast"
        }
      },
      {
        "__template_key": "runninghub_text",
        "name": "rh_seedream_lite",
        "provider": "runninghub",
        "model": "seedream-v5-lite/text-to-image",
        "enabled": true,
        "enabled_as_default": false,
        "fallback_order": 10,
        "refer_field": "",
        "max_refer_images": 0,
        "min_prompt_length": 5,
        "params": {
          "width": 2048,
          "height": 2048,
          "maxImages": 1,
          "sequentialImageGeneration": "disabled"
        }
      },
      {
        "__template_key": "runninghub_edit",
        "name": "rh_dola_seedream_edit",
        "provider": "runninghub",
        "model": "dola-Seedream-5.0-pro/image-to-image",
        "enabled": true,
        "enabled_as_default": false,
        "fallback_order": 11,
        "refer_field": "imageUrls",
        "max_refer_images": 10,
        "min_prompt_length": 5,
        "params": {
          "resolution": "2k",
          "outputFormat": "jpeg"
        }
      },
      {
        "__template_key": "openapi_text",
        "name": "openapi_generic",
        "provider": "openapi",
        "model": "gpt-image-2",
        "enabled": true,
        "enabled_as_default": false,
        "fallback_order": 20,
        "refer_field": "",
        "max_refer_images": 0,
        "min_prompt_length": 0,
        "params": {
          "_endpoint": "images/generations",
          "size": "1024x1024",
          "n": 1
        }
      }
    ],
    "templates": {
      "seedream_text": {
        "name": "WaveSpeed 文生图",
        "items": {
          "name": {
            "type": "str",
            "default": "seedream_v5_pro",
            "description": "模板名称",
            "hint": "--model 参数引用，必须唯一"
          },
          "provider": {
            "type": "str",
            "default": "wavespeed",
            "description": "API 提供商",
            "hint": "wavespeed 或 runninghub"
          },
          "model": {
            "type": "str",
            "default": "bytedance/seedream-v5.0-pro",
            "description": "模型名",
            "hint": "直接拼在 URL 中：POST {base_url}/{model}"
          },
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "启用模板"
          },
          "enabled_as_default": {
            "type": "bool",
            "default": true,
            "description": "允许作为默认模型"
          },
          "fallback_order": {
            "type": "int",
            "default": 0,
            "description": "默认优先级",
            "hint": "数字越小越优先（当前通过 default_text_model/default_edit_model 指定默认，此字段保留备用）"
          },
          "refer_field": {
            "type": "str",
            "default": "",
            "description": "参考图字段名",
            "hint": "图生图模型填 images（或该模型实际字段名）；文生图留空。留空时消息携带的图片会被忽略"
          },
          "max_refer_images": {
            "type": "int",
            "default": 10,
            "description": "参考图数量上限"
          },
          "min_prompt_length": {
            "type": "int",
            "default": 0,
            "description": "提示词最小长度",
            "hint": "0 表示不限制。RunningHub 模型要求至少 5 个字符"
          },
          "params": {
            "type": "object",
            "description": "提交参数（可自由增删键值）",
            "hint": "这些键值会原样写入请求体。提示词中的 --参数 同名覆盖、新键透传。可在代码编辑模式下自由扩展字段",
            "items": {
              "aspect_ratio": {
                "type": "string",
                "default": "1:1",
                "description": "输出比例（如 1:1、16:9）"
              },
              "resolution": {
                "type": "string",
                "default": "1k",
                "description": "分辨率（1k/1.5k/2k）"
              },
              "output_format": {
                "type": "string",
                "default": "jpeg"
              },
              "prompt_optimization_mode": {
                "type": "string",
                "default": "fast"
              }
            }
          }
        }
      },
      "seedream_edit": {
        "name": "WaveSpeed 图片编辑",
        "items": {
          "name": {
            "type": "str",
            "default": "seedream_v5_pro_edit",
            "description": "模板名称",
