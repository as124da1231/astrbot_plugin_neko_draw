                "description": "分辨率（1k/1.5k/2k）"
              },
              "output_format": {
                "type": "string",
                "default": "jpeg"
              },
              "prompt_optimization_mode": {
                "type": "string",
                "default": "fast"
              }
            }
          }
        }
      },
      "runninghub_text": {
        "name": "RunningHub 文生图",
        "items": {
          "name": {
            "type": "str",
            "default": "rh_seedream_lite",
            "description": "模板名称",
            "hint": "--model 参数引用，必须唯一"
          },
          "provider": {
            "type": "str",
            "default": "runninghub",
            "description": "API 提供商",
            "hint": "wavespeed 或 runninghub"
          },
          "model": {
            "type": "str",
            "default": "seedream-v5-lite/text-to-image",
            "description": "RunningHub 模型名",
            "hint": "直接拼在 URL 中：POST {runninghub_base_url}/{model}"
          },
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "启用模板"
          },
          "enabled_as_default": {
            "type": "bool",
            "default": false,
            "description": "允许作为默认模型"
          },
          "fallback_order": {
            "type": "int",
            "default": 10,
            "description": "默认优先级"
          },
          "refer_field": {
            "type": "str",
            "default": "",
            "description": "参考图字段名",
            "hint": "文生图留空"
          },
          "max_refer_images": {
            "type": "int",
            "default": 0,
            "description": "参考图数量上限"
          },
          "min_prompt_length": {
            "type": "int",
            "default": 5,
            "description": "提示词最小长度",
            "hint": "RunningHub 文生图要求 5-2000 字符"
          },
          "params": {
            "type": "object",
            "description": "提交参数（可自由增删键值）",
            "items": {
              "width": {
                "type": "int",
                "default": 2048,
                "description": "输出宽度（像素）"
              },
              "height": {
                "type": "int",
                "default": 2048,
                "description": "输出高度（像素）"
              },
              "maxImages": {
                "type": "int",
                "default": 1,
                "description": "生成图片数量（1-15）"
              },
              "sequentialImageGeneration": {
                "type": "string",
                "default": "disabled",
                "description": "连贯组图（disabled/auto）"
              }
            }
          }
        }
      },
      "runninghub_edit": {
        "name": "RunningHub 图片编辑",
        "items": {
          "name": {
            "type": "str",
            "default": "rh_dola_seedream_edit",
            "description": "模板名称",
            "hint": "--model 参数引用，必须唯一"
          },
          "provider": {
            "type": "str",
            "default": "runninghub",
            "description": "API 提供商",
            "hint": "wavespeed 或 runninghub"
          },
          "model": {
            "type": "str",
            "default": "dola-Seedream-5.0-pro/image-to-image",
            "description": "RunningHub 模型名",
            "hint": "直接拼在 URL 中：POST {runninghub_base_url}/{model}"
          },
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "启用模板"
          },
          "enabled_as_default": {
            "type": "bool",
            "default": false,
            "description": "允许作为默认模型"
          },
          "fallback_order": {
            "type": "int",
            "default": 11,
            "description": "默认优先级"
          },
          "refer_field": {
            "type": "str",
            "default": "imageUrls",
            "description": "参考图字段名",
            "hint": "RunningHub 图生图用 imageUrls"
          },
          "max_refer_images": {
            "type": "int",
            "default": 10,
            "description": "参考图数量上限（最多10）"
          },
          "min_prompt_length": {
            "type": "int",
            "default": 5,
            "description": "提示词最小长度",
            "hint": "具体长度限制以当前模型接口文档为准"
          },
          "params": {
            "type": "object",
            "description": "提交参数（可自由增删键值）",
            "items": {
              "resolution": {
                "type": "string",
                "default": "2k",
                "description": "分辨率（1k/2k，优先于width/height）"
              },
              "outputFormat": {
                "type": "string",
                "default": "jpeg",
                "description": "输出格式（jpeg/png）"
              }
